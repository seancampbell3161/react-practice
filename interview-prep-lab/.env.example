# Copy to backend/.env to override. Every knob is LAB_-prefixed so a stray
# DATABASE_URL in your shell cannot silently repoint the lab.

# Host ports are non-default on purpose (see docker-compose.yml).
LAB_DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5435/lab
LAB_TEST_DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5435/lab_test
LAB_REDIS_URL=redis://localhost:6380/0

LAB_ENV=dev

# Dump every statement SQLAlchemy emits. Turn this on when X-Query-Count tells
# you *how many* queries ran and you need to know *which*.
LAB_ECHO_SQL=false

# The X-Query-Count response header. A teaching instrument, not a feature.
LAB_EXPOSE_QUERY_COUNT=true
